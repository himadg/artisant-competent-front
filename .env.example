# URL de l'API backend.
API_URL=http://localhost:3000

# Clé publique Cloudflare Turnstile (site key), utilisée côté serveur (SSR) pour vérifier l'utilisateur humain.
TURNSTILE_SITE_KEY=turnstile_site_key

# Clé publique Stripe Connect (pk_test_ en local, jamais une clé secrète).
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
